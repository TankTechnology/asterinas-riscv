# SPDX-License-Identifier: MPL-2.0

# Filesystem type under test.
export FSTYP=ext4

# Block devices for the test and scratch partitions.
export TEST_DEV=${XFSTESTS_TEST_DEV:-/dev/vdd}
export SCRATCH_DEV=${XFSTESTS_SCRATCH_DEV:-/dev/vde}

# Mount points where test and scratch devices will be mounted.
export TEST_DIR=/opt/xfstests/test
export SCRATCH_MNT=/opt/xfstests/scratch

# Mount options applied to test and scratch filesystems respectively.
# The compatibility profile does not implement POSIX ACLs.
export MOUNT_OPTIONS="-o noacl"
export EXT_MOUNT_OPTIONS="-o noacl"

export FSTYP_HAS_NON_DEFAULT_OPTS=0
export SELINUX_MOUNT_OPTIONS=" "

# `./check` may reformat the scratch device between cases.  Use the same
# feature profile as the prebuilt test/scratch images.
export MKFS_OPTIONS="-F -O ^metadata_csum,^64bit,^flex_bg,^orphan_file,^huge_file,^dir_nlink,^extra_isize"
