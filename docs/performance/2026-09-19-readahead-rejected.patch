+    ///
+    /// The signal is the page immediately before the range: a sequential
+    /// reader has just brought it in, so it is resident, while a scattered
+    /// reader is unlikely to have touched it. Reading that answer out of the
+    /// cache costs one lookup and keeps the policy stateless, which matters
+    /// because a `BackedVmo` is a short-lived wrapper around a `Vmo` and has
+    /// nowhere of its own to remember a previous access.
+    ///
+    /// A first access into the range is treated as sequential: offset 0 is
+    /// where a reader starts, and a freshly opened file is read from the
+    /// beginning far more often than it is read from a random offset.
+    fn looks_sequential(&self, start_idx: usize) -> bool {
+        start_idx == 0 || self.vmo.is_page_resident((start_idx - 1) * PAGE_SIZE)
+    }
