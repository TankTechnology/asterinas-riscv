+class FirefoxDrmSceneGateTests(unittest.TestCase):
+    def test_new_session_capability_arms_are_explicit(self) -> None:
+        with patch.dict("os.environ", {}, clear=False):
+            self.assertEqual(
+                _new_session_capabilities(),
