+        with patch("tools.riscv.debian.rootfs.firefox_drm_scene_gate._probe_proc_snapshot", return_value=snapshot), patch(
+            "tools.riscv.debian.rootfs.firefox_drm_scene_gate._probe_log_snapshot",
