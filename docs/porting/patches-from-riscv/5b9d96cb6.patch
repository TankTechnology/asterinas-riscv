new file mode 100644
index 000000000..f13eed69f
--- /dev/null
+++ b/tools/riscv/qemu_dwc3_contract.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MPL-2.0
+
+"""Static contract for the EIC7700 DWC3 fault-isolation qtests.
+
+The runtime qtests live in the companion QEMU checkout.  This small parser
+keeps the important negative-test shape visible to the Asterinas host gate:
+reset, IRQ-without-event-ring, and unimplemented-register reads must not add a
+USB device or write guest DMA memory.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import re
+
+
+class QemuDwc3ContractError(ValueError):
+    """The QEMU source does not preserve the DWC3 fault contract."""
+
+
+@dataclass(frozen=True)
+class QemuDwc3SourceContract:
+    """Facts extracted from the DWC3 qtest source."""
+
+    functions: tuple[str, ...]
+    registrations: tuple[str, ...]
+    no_device_or_dma_in_faults: bool
+
+
+_FUNCTION_START = re.compile(
+    r"static\s+void\s+(?P<name>test_dwc3_fault_[a-z0-9_]+)\s*\([^)]*\)\s*\{",
+    re.MULTILINE,
+)
+_REGISTRATION = re.compile(
+    r'qtest_add_func\("/eic7700/dwc3/(?P<name>fault-[a-z0-9-]+)"\s*,\s*'
+    r"(?P<function>test_dwc3_fault_[a-z0-9_]+)\s*\);",
+    re.MULTILINE,
+)
+
+_EXPECTED = {
+    "test_dwc3_fault_reset_isolates_xhci": (
+        "DWC3_GCTL",
+        "XHCI_USBCMD",
+        "XHCI_USBSTS",
+        "XHCI_IMAN",
+        "XHCI_ERSTSZ",
+        "qtest_get_irq",
+    ),
+    "test_dwc3_fault_irq_without_event_ring_isolated": (
+        "XHCI_IMAN",
+        "XHCI_ERSTBA_LO",
+        "XHCI_ERDP_LO",
+        "XHCI_USBSTS",
+        "qtest_get_irq",
+    ),
+    "test_dwc3_fault_register_read_is_fail_closed": (
+        "DWC3_GUSB2I2CCTL",
+        "XHCI_USBCMD",
+        "XHCI_IMAN",
+        "XHCI_ERSTSZ",
+        "qtest_get_irq",
+    ),
+}
+
+
+def _function_bodies(source: str) -> dict[str, str]:
+    bodies: dict[str, str] = {}
+    for match in _FUNCTION_START.finditer(source):
+        depth = 1
+        index = match.end()
+        while depth and index < len(source):
+            if source[index] == "{":
+                depth += 1
+            elif source[index] == "}":
+                depth -= 1
+            index += 1
+        if depth:
+            raise QemuDwc3ContractError(
+                f"unterminated DWC3 fault function {match.group('name')}"
+            )
+        bodies[match.group("name")] = source[match.start() : index]
+    return bodies
+
+
+def validate_qemu_dwc3_source(source: str) -> QemuDwc3SourceContract:
+    """Validate the three runtime fault tests and their registrations."""
+
+    bodies = _function_bodies(source)
+    expected_names = tuple(_EXPECTED)
+    if tuple(bodies) != expected_names:
+        raise QemuDwc3ContractError(
+            f"DWC3 fault functions must be {expected_names!r}, got {tuple(bodies)!r}"
+        )
+    for name, needles in _EXPECTED.items():
+        body = bodies[name]
+        if "qtest_qmp_device_add" in body:
+            raise QemuDwc3ContractError(f"{name} enumerates a USB device")
+        if "qtest_memwrite" in body or "qtest_memread" in body:
+            raise QemuDwc3ContractError(f"{name} performs guest DMA memory I/O")
+        missing = tuple(needle for needle in needles if needle not in body)
+        if missing:
+            raise QemuDwc3ContractError(f"{name} misses {missing!r}")
+
+    registrations = tuple(
+        match.group("function") for match in _REGISTRATION.finditer(source)
+    )
+    if registrations != expected_names:
+        raise QemuDwc3ContractError(
+            f"DWC3 fault tests are not registered in order: {registrations!r}"
+        )
+    return QemuDwc3SourceContract(
+        functions=expected_names,
+        registrations=registrations,
+        no_device_or_dma_in_faults=True,
+    )
diff --git a/tools/riscv/qemu_fallback_receipt.py b/tools/riscv/qemu_fallback_receipt.py
new file mode 100644
index 000000000..babc4b0a7
--- /dev/null
+++ b/tools/riscv/qemu_fallback_receipt.py
@@ -0,0 +1,176 @@
+#!/usr/bin/env python3
+"""Create a bounded receipt for the second-boot QEMU fallback boundary.
+
+This tool only parses a captured serial transcript.  It does not start QEMU,
+write a serial device, or access hardware.  The recovery marker is required
+before any U-Boot prompt or RockOS login can be considered a fallback; an
+initial firmware prompt is deliberately classified as unknown.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+from enum import Enum
+from pathlib import Path
+from typing import Sequence
+
+
+RECOVERY_MARKER = "ASTERINAS_REBOOT_TIMER_READY"
+LINUX_REFERENCE_MARKER = "ASTERINAS_LINUX_REFERENCE_READY"
+_ROCKOS_LOGIN_PATTERN = re.compile(r"(?mi)^[ \t]*rockos-eswin login:[ \t]*$")
+_BOOT_ID_PATTERN = re.compile(
+    r"\bboot[_-]?id\s*[=:]\s*"
+    r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
+    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\b"
+)
+_TAIL_BYTES = 4096
+
+
+class FallbackKind(str, Enum):
+    """Fallback payloads that have an independently observable terminal."""
+
+    LINUX_REFERENCE = "linux-reference"
+    ROCKOS_LOGIN = "rockos-login"
+
+
+class FallbackReceiptError(ValueError):
+    """The requested fallback contract is not supported."""
+
+
+def _coerce_kind(value: FallbackKind | str) -> FallbackKind:
+    try:
+        return value if isinstance(value, FallbackKind) else FallbackKind(value)
+    except ValueError as error:
+        raise FallbackReceiptError(f"unsupported fallback kind: {value!r}") from error
+
+
+def _post_recovery(serial_text: str) -> tuple[str, int]:
+    count = serial_text.count(RECOVERY_MARKER)
+    if count == 0:
+        return "", 0
+    position = serial_text.find(RECOVERY_MARKER)
+    return serial_text[position + len(RECOVERY_MARKER) :], count
+
+
+def _observed_fallback(post_recovery: str) -> str:
+    linux = post_recovery.count(LINUX_REFERENCE_MARKER)
+    rockos = _ROCKOS_LOGIN_PATTERN.search(post_recovery) is not None
+    if linux and rockos:
+        return "mixed"
+    if linux:
+        return "linux-reference"
+    if rockos:
+        return "rockos-login"
+    if "=> " in post_recovery:
+        return "uboot-prompt"
+    return "unknown"
+
+
+def build_fallback_receipt(
+    serial_text: str,
+    *,
+    fallback_kind: FallbackKind | str,
+) -> dict[str, object]:
+    """Classify one serial transcript without upgrading ambiguous evidence."""
+
+    expected = _coerce_kind(fallback_kind)
+    post_recovery, recovery_count = _post_recovery(serial_text)
+    observed = _observed_fallback(post_recovery)
+    boot_ids: list[str] = []
+    for match in _BOOT_ID_PATTERN.finditer(serial_text):
+        boot_id = match.group(1).lower()
+        if boot_id not in boot_ids:
+            boot_ids.append(boot_id)
+
+    failure: str | None = None
+    if recovery_count == 0:
+        failure = "recovery-marker-missing"
+    elif recovery_count != 1:
+        failure = "recovery-marker-count"
+    elif serial_text.count(LINUX_REFERENCE_MARKER) > 1:
+        failure = "fallback-marker-count"
+    elif expected is FallbackKind.LINUX_REFERENCE:
+        if serial_text.count(LINUX_REFERENCE_MARKER) != 1:
+            failure = "fallback-marker-missing"
+        elif observed != expected.value:
+            failure = "fallback-kind-mismatch"
+    elif observed != expected.value:
+        failure = "fallback-kind-mismatch"
+
+    if failure is None and serial_text.count("OpenSBI v") < 2:
+        failure = "opensbi-epoch-missing"
+    if failure is None and serial_text.count("U-Boot ") < 2:
+        failure = "uboot-epoch-missing"
+
+    passed = failure is None
+    if passed:
+        recovery_state = "recovered-to-fallback"
+    elif recovery_count:
+        recovery_state = "recovery-observed-fallback-missing"
+    else:
+        recovery_state = "not-recovered"
+    serial_bytes = serial_text.encode("utf-8", errors="replace")
+    tail = serial_bytes[-_TAIL_BYTES:]
+    return {
+        "schema": "asterinas.qemu-fallback-receipt.v1",
+        "execution_scope": "qemu-guest",
+        "hardware_state": "not-accessed",
+        "expected_fallback": expected.value,
+        "observed_fallback": observed,
+        "passed": passed,
+        "failure": failure,
+        "recovery_state": recovery_state,
+        "watchdog_state": "armed" if recovery_count else "missing",
+        "watchdog_kind": (
+            "software-recovery-timer" if recovery_count else "not-observed"
+        ),
+        "recovery_marker_count": recovery_count,
+        "linux_reference_marker_count": serial_text.count(LINUX_REFERENCE_MARKER),
+        "boot_ids": boot_ids,
+        "boot_id_state": "observed" if boot_ids else "missing",
+        "opensbi_epochs": serial_text.count("OpenSBI v"),
+        "uboot_epochs": serial_text.count("U-Boot "),
+        "serial_bytes": len(serial_bytes),
+        "serial_tail_sha256": hashlib.sha256(tail).hexdigest(),
+        "serial_tail": tail.decode("utf-8", errors="replace"),
+    }
+
+
+def _parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--serial-log", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument(
+        "--fallback-kind",
+        choices=tuple(kind.value for kind in FallbackKind),
+        required=True,
+    )
+    return parser.parse_args(argv)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _parse_args(argv)
+    try:
+        serial_text = args.serial_log.read_text(encoding="utf-8", errors="replace")
+        receipt = build_fallback_receipt(
+            serial_text,
+            fallback_kind=args.fallback_kind,
+        )
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(
+            json.dumps(receipt, indent=2, sort_keys=True) + "\n",
+            encoding="utf-8",
+        )
+    except (OSError, FallbackReceiptError) as error:
+        print(f"qemu fallback receipt: {error}", file=sys.stderr)
+        return 2
+    print(json.dumps(receipt, indent=2, sort_keys=True))
+    return 0 if receipt["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/riscv/qemu_gmac_contract.py b/tools/riscv/qemu_gmac_contract.py
new file mode 100644
index 000000000..5ea06d693
--- /dev/null
+++ b/tools/riscv/qemu_gmac_contract.py
@@ -0,0 +1,166 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MPL-2.0
+
+"""Static contract checks for the EIC7700 GMAC QTest model.
+
+The physical probe and the QEMU model must agree on the bounded read
+whitelist.  This module deliberately checks source text only; it never starts
+QEMU and never touches a board.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+import re
+
+from tools.riscv.eic7700_platform_contract import EIC7700
+from tools.riscv.megrez_hardware_probe import PROBE_SPECS
+
+
+class QemuGmacContractError(ValueError):
+    """The QEMU source does not implement the bounded GMAC contract."""
+
+
+@dataclass(frozen=True)
+class QemuGmacSourceContract:
+    """Facts extracted from one EIC7700 GMAC qtest source file."""
+
+    gmac_bases: tuple[int, int]
+    probe_offsets: tuple[int, ...]
+    has_gated_read_write_check: bool
+    has_readonly_probe_check: bool
+    has_mmio_timeout_check: bool
+    has_platform_sequence_check: bool
+    has_reset_gate_check: bool
+    has_phy_absent_check: bool
+    has_unreachable_descriptor_check: bool
+
+
+_MACRO = re.compile(
+    r"^\s*#define\s+(?P<name>[A-Z][A-Z0-9_]*)\s+"
+    r"(?P<value>0x[0-9a-fA-F]+|[0-9]+)(?:ULL|UL|LL|U|L)?\b",
+    re.MULTILINE,
+)
+_READONLY_ARRAY = re.compile(
+    r"static\s+const\s+uint32_t\s+readonly_offsets\s*\[\s*\]\s*=\s*"
+    r"\{(?P<body>.*?)\};",
+    re.DOTALL,
+)
+_IDENTIFIER = re.compile(r"\b[A-Z][A-Z0-9_]*\b")
+
+_OFFSET_MACROS = (
+    "GMAC_MAC_CONFIGURATION",
+    "GMAC_MAC_INTERRUPT_STATUS",
+    "GMAC_MAC_VERSION",
+    "GMAC_MAC_HW_FEATURE1",
+    "GMAC_DMA_MODE",
+    "GMAC_DMA_STATUS",
+)
+
+
+def _macros(source: str) -> dict[str, int]:
+    values: dict[str, int] = {}
+    for match in _MACRO.finditer(source):
+        values[match.group("name")] = int(match.group("value"), 0)
+    return values
+
+
+def parse_qemu_gmac_probe_offsets(source: str) -> tuple[int, ...]:
+    """Extract the qtest read whitelist in source order."""
+
+    array = _READONLY_ARRAY.search(source)
+    if array is None:
+        raise QemuGmacContractError("QEMU source has no readonly_offsets array")
+    names = tuple(_IDENTIFIER.findall(array.group("body")))
+    if names != _OFFSET_MACROS:
+        raise QemuGmacContractError(
+            "QEMU readonly_offsets must contain the six GMAC probe offsets "
+            f"in order, got {names!r}"
+        )
+    values = _macros(source)
+    try:
+        return tuple(values[name] for name in names)
+    except KeyError as error:
+        raise QemuGmacContractError(
+            f"QEMU source is missing GMAC offset macro {error.args[0]}"
+        ) from error
+
+
+def validate_qemu_gmac_source(source: str) -> QemuGmacSourceContract:
+    """Validate the QEMU fail-closed model without executing it."""
+
+    values = _macros(source)
+    try:
+        bases = (values["GMAC0_BASE"], values["GMAC1_BASE"])
+    except KeyError as error:
+        raise QemuGmacContractError(
+            f"QEMU source is missing {error.args[0]}"
+        ) from error
+    if bases != (
+        EIC7700.peripheral("gmac-0").base,
+        EIC7700.peripheral("gmac-1").base,
+    ):
+        raise QemuGmacContractError(
+            f"QEMU GMAC bases {bases!r} disagree with the host registry"
+        )
+
+    offsets = parse_qemu_gmac_probe_offsets(source)
+    expected = EIC7700.peripheral("gmac-1").probe_offsets
+    if offsets != expected:
+        raise QemuGmacContractError(
+            f"QEMU probe offsets {offsets!r} disagree with Asterinas {expected!r}"
+        )
+
+    checks = {
+        "has_gated_read_write_check": (
+            "test_gmac_clock_gated",
+            "UINT32_MAX",
+            "qtest_writel(qts, GMAC1_BASE + GMAC_DMA_MODE",
+        ),
+        "has_readonly_probe_check": (
+            "test_gmac_readonly_probe_contract",
+            "readonly_offsets",
+            "Repeated reads must remain bounded",
+        ),
+        "has_mmio_timeout_check": (
+            "test_gmac_mmio_timeout_fail_closed",
+            "eic7700-gmac1-mmio-timeout=on",
+            "GMAC_MDIO_BUSY",
+            "No PHY transaction, descriptor, or IRQ",
+        ),
+        "has_platform_sequence_check": (
+            "test_gmac_platform_sequence_enables_gated_port",
+            "SYSCRG_BASE + 0x148",
+            "GMAC1_BASE + GMAC_MAC_VERSION",
+        ),
+        "has_reset_gate_check": (
+            "test_gmac_reset_assertion_closes_gate",
+            "SYSCRG_BASE + 0x41c",
+            "UINT32_MAX",
+        ),
+        "has_phy_absent_check": (
+            "test_gmac_phy_absent_fail_closed",
+            "eic7700-gmac1-phy-absent=on",
+            "0xffff",
+            "GMAC_DMA_STATUS",
+        ),
+        "has_unreachable_descriptor_check": (
+            "test_gmac_unreachable_descriptor_is_bounded",
+            "eic7700-gmac1-irq-drop=on",
+            "0xdead0000",
+            "qtest_get_irq",
+        ),
+    }
+    results: dict[str, bool] = {}
+    for field, needles in checks.items():
+        present = all(needle in source for needle in needles)
+        if not present:
+            raise QemuGmacContractError(
+                f"QEMU source is missing fail-closed check {field}"
+            )
+        results[field] = True
+    return QemuGmacSourceContract(
+        gmac_bases=bases,
+        probe_offsets=offsets,
+        **results,
+    )
