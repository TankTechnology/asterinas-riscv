+        struct.pack_into("<H", payload, 18, 243)
+        elf.write_bytes(payload)
+        compiler = directory / "fake-riscv-cc"
+        compiler.write_text(
+            "#!/bin/sh\n"
+            'while [ "$1" != -o ]; do shift; done\n'
+            "shift\n"
+            'cp -- "$FAKE_RISCV_ELF" "$1"\n'
