-[ -x "$BUILD_SCRIPT" ] || die "missing $BUILD_SCRIPT"
-[ -x "$NET_VALIDATE" ] || die "missing $NET_VALIDATE"
-[ -x "$PIXEL_VALIDATE" ] || die "missing $PIXEL_VALIDATE"
