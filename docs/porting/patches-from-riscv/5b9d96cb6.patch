-BUILD_SCRIPT="${SRC_DIR}/build_systemd_desktop.sh"
-NET_VALIDATE="${XORG_DIR}/net_validate.sh"
-PIXEL_VALIDATE="${XORG_DIR}/pixel_validate.py"
