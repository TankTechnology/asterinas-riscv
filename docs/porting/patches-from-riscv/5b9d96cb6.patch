+                    self._bootargs = self._bootargs.replace(
+                        "systemd.setenv=ASTERINAS_FIREFOX_PROBE_ONLY=1",
+                        "systemd.setenv=ASTERINAS_FIREFOX_PROBE_ONLY=1 "
+                        "systemd.setenv=ASTERINAS_FIREFOX_REMOTE_TRACE=1",
+                    )
