+            self.assertEqual(
+                _new_session_capabilities(),
+                {
+                    "acceptInsecureCerts": False,
+                    "pageLoadStrategy": "none",
+                    "strictFileInteractability": True,
+                },
+            )
+        with patch.dict("os.environ", {"ASTERINAS_FIREFOX_NEWSESSION_CAPS": "envelope"}):
+            self.assertEqual(
+                _new_session_capabilities(),
+                {
+                    "capabilities": {
+                        "alwaysMatch": {
