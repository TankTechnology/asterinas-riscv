new file mode 100644
index 000000000..5802a35ba
--- /dev/null
+++ b/tools/riscv/qemu_goal_audit.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Audit the QEMU evidence for the Asterinas recovery/display/device goal.
+
+This is a read-only evidence joiner. It never starts QEMU, opens a serial
+device, modifies a guest image, or treats a host-only fault shim as guest
+watchdog evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+
+_OK_LINE = re.compile(r"^ok\s+\d+\s+", re.MULTILINE)
+
+
+def _read_json(path: Path) -> dict[str, Any] | None:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _read_first_json(paths: list[Path]) -> tuple[dict[str, Any] | None, Path]:
+    """Read the first accessible JSON artifact, preserving its evidence path."""
+
+    for path in paths:
+        value = _read_json(path)
+        if value is not None:
+            return value, path
+    return None, paths[0]
+
+
+def _check(name: str, status: str, reason: str, evidence: str) -> dict[str, str]:
+    return {"name": name, "status": status, "reason": reason, "evidence": evidence}
+
+
+def build_goal_audit(root: Path = Path(".")) -> dict[str, Any]:
+    """Join current receipts without upgrading missing or weak evidence."""
+
+    recovery_path = root / "target/qemu-uboot/final-recovery-20261011/receipt.json"
+    recovery = _read_json(recovery_path)
+    timer_path = root / "target/qemu-guest-faults/timer-disabled-20261011/receipt.json"
+    timer = _read_json(timer_path)
+    sbi_path = root / "target/qemu-guest-faults/sbi-reset-failure-20261011/receipt.json"
+    sbi = _read_json(sbi_path)
+    fault_matrix_path = root / "target/qemu-recovery-faults/matrix-20261011/receipt.json"
+    fault_matrix = _read_json(fault_matrix_path)
+    fb_path = root / "target/qemu-desktop-m4-fb-recovery-20261011-r4/result.json"
+    fb_fallback_path = root / "target/qemu-goal-audit-20261011/fb-result.json"
+    fb, fb_evidence_path = _read_first_json([fb_path, fb_fallback_path])
+    tap_path = root / "target/qemu-eic7700-qtest-20261011/tap.txt"
+    try:
+        tap = tap_path.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        tap = ""
+
+    checks: list[dict[str, str]] = []
+    if recovery is None:
+        checks.append(_check("software-recovery", "missing", "receipt-unreadable", str(recovery_path)))
+        checks.append(_check("rockos-fallback", "missing", "receipt-unreadable", str(recovery_path)))
+        checks.append(_check("automatic-receipts", "missing", "receipt-unreadable", str(recovery_path)))
+    else:
+        checks.append(_check(
+            "software-recovery",
+            "passed" if recovery.get("recovery_state") == "recovered" else "insufficient",
+            "Asterinas-to-firmware recovery state",
+            str(recovery_path),
+        ))
+        fallback = recovery.get("fallback_state")
+        checks.append(_check(
+            "rockos-fallback",
+            "passed" if fallback == "rockos-login" else "missing",
+            f"observed fallback={fallback!r}; U-Boot is not RockOS",
+            str(recovery_path),
+        ))
+        checks.append(_check(
+            "automatic-receipts",
+            "passed"
+            if recovery.get("serial_tail_sha256") and recovery.get("boot_id_state") == "observed"
+            else "insufficient",
+            "serial tail hash and boot identity",
+            str(recovery_path),
+        ))
+
+    checks.append(_check(
+        "framebuffer",
+        "passed" if fb is not None and fb.get("passed") is True else "missing",
+        "fb0 userspace transaction result",
+        str(fb_evidence_path),
+    ))
+    checks.append(_check(
+        "timer-disabled",
+        "passed"
+        if timer is not None
+        and timer.get("classification") == "timer-disabled"
+        and timer.get("qualified") is True
+        else "missing",
+        "guest timer fault receipt",
+        str(timer_path),
+    ))
+    checks.append(_check(
+        "sbi-reset-failure",
+        "passed"
+        if sbi is not None
+        and sbi.get("classification") == "sbi-reset-failure"
+        and sbi.get("classification_complete") is True
+        else "missing",
+        "guest SBI reset fault receipt",
+        str(sbi_path),
+    ))
+
+    qtest_ok = len(_OK_LINE.findall(tap))
+    qtest_required = (
+        "fault-register-read-fail-closed" in tap
+        and "mmio-timeout-fail-closed" in tap
+        and qtest_ok >= 19
+    )
+    checks.append(_check(
+        "gmac-dwc3-qtest",
+        "passed" if qtest_required else "missing",
+        f"QTest ok-lines={qtest_ok}; GMAC/DWC3 fault names present={qtest_required}",
+        str(tap_path),
+    ))
+
+    guest_mmio = (
+        fault_matrix is not None
+        and fault_matrix.get("execution_scope") == "qemu-guest"
+        and fault_matrix.get("classification_complete") is True
+        and fault_matrix.get("qualified") is True
+        and "mmio-permanent-block" in fault_matrix.get("faults", [])
+    )
+    checks.append(_check(
+        "mmio-permanent-block",
+        "passed" if guest_mmio else "insufficient",
+        "requires a guest-scoped receipt; host-serial-peer is insufficient",
+        str(fault_matrix_path),
+    ))
+
+    return {
+        "schema": "asterinas.qemu-goal-audit.v1",
+        "execution_scope": "host-evidence-audit",
+        "hardware_state": "not-accessed",
+        "passed": all(item["status"] == "passed" for item in checks),
+        "checks": checks,
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--root", type=Path, default=Path("."))
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args(argv)
+    audit = build_goal_audit(args.root)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(audit, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    print(json.dumps(audit, indent=2, sort_keys=True))
+    return 0 if audit["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/riscv/qemu_guest_fault_receipt.py b/tools/riscv/qemu_guest_fault_receipt.py
new file mode 100644
index 000000000..87604743b
--- /dev/null
+++ b/tools/riscv/qemu_guest_fault_receipt.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Classify bounded fault boundaries observed from an actual QEMU guest.
+
+This parser consumes the guarded runner's ``result.json`` and serial log.  It
+does not start QEMU or touch hardware.  It supports SBI reset failure and the
+post-handoff timer-disabled boundary; both require a single firmware epoch.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Mapping, Sequence
+
+
+RECOVERY_MARKER = "ASTERINAS_REBOOT_TIMER_READY"
+ARMED_MARKER = "ASTERINAS_SOFTWARE_REBOOT_ARMED"
+_TAIL_BYTES = 4096
+_BOOT_ID_RE = re.compile(
+    r"\bboot[_-]?id\s*[=:]\s*"
+    r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
+    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\b"
+)
+
+
+class GuestFaultReceiptError(ValueError):
+    """The guest transcript does not satisfy the selected fault contract."""
+
+
+def build_guest_fault_receipt(
+    result: Mapping[str, object],
+    serial_text: str,
+    *,
+    fault: str = "sbi-reset-failure",
+) -> dict[str, object]:
+    """Validate one bounded QEMU guest fault boundary."""
+
+    if fault not in {"sbi-reset-failure", "timer-disabled"}:
+        raise GuestFaultReceiptError(f"unsupported guest fault: {fault!r}")
+    argv = result.get("qemu_argv")
+    if not isinstance(argv, list) or "-no-reboot" not in argv:
+        raise GuestFaultReceiptError("guest reset-failure run must use -no-reboot")
+    session = result.get("session")
+    if not isinstance(session, Mapping):
+        raise GuestFaultReceiptError("runner result has no session object")
+    if session.get("cleanup_complete") is not True:
+        raise GuestFaultReceiptError("QEMU process cleanup is incomplete")
+    if session.get("recovery_complete") is not False:
+        raise GuestFaultReceiptError("guest unexpectedly reported recovery")
+    if serial_text.count(ARMED_MARKER) != 1:
+        raise GuestFaultReceiptError("software recovery timer marker count is not one")
+    if serial_text.count(RECOVERY_MARKER) != 1:
+        raise GuestFaultReceiptError("recovery marker count is not one")
+    opensbi_epochs = serial_text.count("OpenSBI v")
+    uboot_banner_count = serial_text.count("U-Boot ")
+    # U-Boot prints its version once during the banner and may print it again
+    # when the guarded command sequence asks for ``version``.  OpenSBI is the
+    # epoch boundary; require one U-Boot banner, but do not mistake the second
+    # version line for a second firmware reset.
+    uboot_epochs = 1 if uboot_banner_count >= 1 else 0
+    if opensbi_epochs != 1 or uboot_epochs != 1:
+        raise GuestFaultReceiptError(
+            f"expected one firmware epoch, got OpenSBI={opensbi_epochs}, U-Boot={uboot_banner_count}"
+        )
+    qualified = False
+    watchdog_state = "guest-software-timer-armed"
+    if fault == "sbi-reset-failure":
+        if session.get("returncode") != 0:
+            raise GuestFaultReceiptError("QEMU did not exit with the expected code")
+    else:
+        machine_args = [
+            str(argv[index + 1])
+            for index, value in enumerate(argv[:-1])
+            if value == "-machine"
+        ]
+        if not any("timer-fault-after-boot=on" in value for value in machine_args):
+            raise GuestFaultReceiptError(
+                "timer-disabled fault must be armed after the booti handoff"
+            )
+        observation_seconds = result.get("post_terminal_timeout_seconds")
+        if (
+            not isinstance(observation_seconds, (int, float))
+            or observation_seconds <= 0
+        ):
+            raise GuestFaultReceiptError(
+                "timer-disabled fault must record a positive post-terminal observation"
+            )
+        bounded_stop = session.get("timed_out") is True or (
+            session.get("termination_action") == "SIGTERM"
+            and session.get("returncode") == 0
+        )
+        if session.get("marker_seen") is not True or not bounded_stop:
+            raise GuestFaultReceiptError(
+                "timer-disabled fault must reach the guest marker and bounded timeout"
+            )
+        qualified = True
+        watchdog_state = "guest-software-timer-stalled"
+    serial_bytes = serial_text.encode("utf-8", errors="replace")
+    tail = serial_bytes[-_TAIL_BYTES:]
+    boot_ids: list[str] = []
+    for match in _BOOT_ID_RE.finditer(serial_text):
+        value = match.group(1).lower()
+        if value not in boot_ids:
+            boot_ids.append(value)
+    return {
+        "schema": "asterinas.qemu-guest-fault-receipt.v1",
+        "execution_scope": "qemu-guest",
+        "hardware_state": "not-accessed",
+        "fault": fault,
+        "classification": fault,
+        "classification_complete": True,
+        "qualified": qualified,
+        "recovery_state": "not-recovered",
+        "watchdog_state": watchdog_state,
+        "watchdog_kind": "software-recovery-timer",
+        "opensbi_epochs": opensbi_epochs,
+        "uboot_epochs": uboot_epochs,
+        "uboot_banner_count": uboot_banner_count,
+        "boot_ids": boot_ids,
+        "serial_bytes": len(serial_bytes),
+        "serial_tail_sha256": hashlib.sha256(tail).hexdigest(),
+        "serial_tail": tail.decode("utf-8", errors="replace"),
+    }
+
+
+def _parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--result", type=Path, required=True)
+    parser.add_argument("--serial-log", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--fault", default="sbi-reset-failure")
+    return parser.parse_args(argv)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _parse_args(argv)
+    try:
+        result = json.loads(args.result.read_text(encoding="utf-8"))
+        serial_text = args.serial_log.read_text(encoding="utf-8", errors="replace")
+        receipt = build_guest_fault_receipt(result, serial_text, fault=args.fault)
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(
+            json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )
+    except (OSError, json.JSONDecodeError, GuestFaultReceiptError) as error:
+        print(f"qemu guest fault receipt: {error}", file=sys.stderr)
+        return 2
+    print(json.dumps(receipt, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/riscv/qemu_plugins/eic7700_boot_trace.c b/tools/riscv/qemu_plugins/eic7700_boot_trace.c
new file mode 100644
index 000000000..e03924336
--- /dev/null
+++ b/tools/riscv/qemu_plugins/eic7700_boot_trace.c
@@ -0,0 +1,132 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/*
+ * Small QEMU TCG plugin for bounded Asterinas boot traces.
+ *
+ * It intentionally reports only aggregate translation, instruction, idle and
+ * resume counters.  It does not inspect guest memory or claim to be a timing
+ * model; use it to find an execution loop or an unexpected idle boundary.
+ */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <qemu-plugin.h>
+
+#define TRACE_OUTPUT_PATH_MAX 4096
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+static uint64_t tb_count;
+static uint64_t insn_count;
+static uint64_t idle_count;
+static uint64_t resume_count;
+static char trace_output_path[TRACE_OUTPUT_PATH_MAX];
+
+static void tb_exec(unsigned int cpu_index, void *userdata)
+{
+    (void)cpu_index;
+    __atomic_fetch_add(&tb_count, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&insn_count, (uintptr_t)userdata, __ATOMIC_RELAXED);
+}
+
+static void tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    size_t insns = qemu_plugin_tb_n_insns(tb);
+
+    (void)id;
+    qemu_plugin_register_vcpu_tb_exec_cb(tb, tb_exec, QEMU_PLUGIN_CB_NO_REGS,
+                                         (void *)(uintptr_t)insns);
+}
+
+static void vcpu_idle(qemu_plugin_id_t id, unsigned int cpu_index)
+{
+    (void)id;
+    (void)cpu_index;
+    __atomic_fetch_add(&idle_count, 1, __ATOMIC_RELAXED);
+}
+
+static void vcpu_resume(qemu_plugin_id_t id, unsigned int cpu_index)
+{
+    (void)id;
+    (void)cpu_index;
+    __atomic_fetch_add(&resume_count, 1, __ATOMIC_RELAXED);
+}
+
+static int build_report(char *report, size_t capacity)
+{
+    return snprintf(report, capacity,
+                    "ASTERINAS_QEMU_TCG_TRACE tb=%" PRIu64
+                    " insns=%" PRIu64 " idle=%" PRIu64
+                    " resume=%" PRIu64 "\n",
+                    __atomic_load_n(&tb_count, __ATOMIC_RELAXED),
+                    __atomic_load_n(&insn_count, __ATOMIC_RELAXED),
+                    __atomic_load_n(&idle_count, __ATOMIC_RELAXED),
+                    __atomic_load_n(&resume_count, __ATOMIC_RELAXED));
+}
+
+static void write_report_file(const char *report)
+{
+    FILE *stream;
+
+    if (trace_output_path[0] == '\0') {
+        return;
+    }
+    stream = fopen(trace_output_path, "w");
+    if (stream == NULL) {
+        qemu_plugin_outs("ASTERINAS_QEMU_TCG_TRACE_FILE status=open-failed\n");
+        return;
+    }
+    if (fputs(report, stream) == EOF || fclose(stream) != 0) {
+        qemu_plugin_outs("ASTERINAS_QEMU_TCG_TRACE_FILE status=write-failed\n");
+        return;
+    }
+    qemu_plugin_outs("ASTERINAS_QEMU_TCG_TRACE_FILE status=written\n");
+}
+
+static void plugin_exit(qemu_plugin_id_t id, void *userdata)
+{
+    char report[256];
+    int length;
+
+    (void)id;
+    (void)userdata;
+    length = build_report(report, sizeof(report));
+    if (length <= 0 || (size_t)length >= sizeof(report)) {
+        qemu_plugin_outs("ASTERINAS_QEMU_TCG_TRACE_FILE status=report-overflow\n");
+        return;
+    }
+    write_report_file(report);
+    qemu_plugin_outs(report);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    const char *output;
+
+    (void)info;
+    (void)argv;
+    if (argc != 0) {
+        return -1;
+    }
+    output = getenv("ASTERINAS_QEMU_TCG_TRACE_OUTPUT");
+    if (output != NULL && *output != '\0') {
+        size_t length = strlen(output);
+        if (length >= sizeof(trace_output_path)) {
+            return -1;
+        }
+        memcpy(trace_output_path, output, length + 1);
+    }
+    fprintf(stderr, "ASTERINAS_QEMU_TCG_TRACE_START\n");
+    qemu_plugin_outs("ASTERINAS_QEMU_TCG_TRACE_START\n");
+    qemu_plugin_register_vcpu_tb_trans_cb(id, tb_trans);
+    qemu_plugin_register_vcpu_idle_cb(id, vcpu_idle);
+    qemu_plugin_register_vcpu_resume_cb(id, vcpu_resume);
+    qemu_plugin_register_atexit_cb(id, plugin_exit, NULL);
+    return 0;
+}
+
diff --git a/tools/riscv/qemu_recovery_faults.py b/tools/riscv/qemu_recovery_faults.py
new file mode 100644
index 000000000..a40aaa641
--- /dev/null
+++ b/tools/riscv/qemu_recovery_faults.py
@@ -0,0 +1,258 @@
+"""Deterministic QEMU/U-Boot recovery fault injection and classification.
+
+The faults in this module are host-side serial protocol injections.  They do
+not touch a board or a real MMIO device; their purpose is to make the recovery
+receipt distinguish a kernel hang from a missing SBI reset and from a boot
+loader that never exposes a prompt.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import sys
+import tempfile
+from dataclasses import dataclass
+from enum import Enum
+from pathlib import Path
+from typing import Mapping, Sequence
+
+from qemu_uboot_commands import BootCommand
+from qemu_uboot_session import RebootExpectation, SessionResult, run_serial_session
+
+
+class RecoveryFault(str, Enum):
+    """Faults whose containment and recovery evidence are tested."""
+
+    TIMER_DISABLED = "timer-disabled"
+    SBI_RESET_FAILURE = "sbi-reset-failure"
+    MMIO_PERMANENT_BLOCK = "mmio-permanent-block"
+    UBOOT_WAIT = "uboot-wait"
+
+
+REBOOT_TIMER_READY = b"ASTERINAS_REBOOT_TIMER_READY"
+_FAULT_RE = re.compile(rb"ASTERINAS_FAULT_INJECTED fault=([a-z0-9-]+)")
+_BOOT_ID_RE = re.compile(
+    rb"\bboot[_-]?id\s*[=:]\s*"
+    rb"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
+    rb"[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\b"
+)
+
+
+class RecoveryFaultError(ValueError):
+    """The serial result does not satisfy the selected fault contract."""
+
+
+@dataclass(frozen=True)
+class FaultRun:
+    """One contained synthetic failure and its machine-readable receipt."""
+
+    fault: RecoveryFault
+    result: SessionResult
+    serial: bytes
+    receipt: Mapping[str, object]
+
+
+def _expected_failure(fault: RecoveryFault) -> str:
+    if fault is RecoveryFault.UBOOT_WAIT:
+        return "startup-timeout"
+    if fault is RecoveryFault.SBI_RESET_FAILURE:
+        return "recovery-timeout:opensbi"
+    return "boot-timeout"
+
+
+def classify_fault(
+    fault: RecoveryFault,
+    result: SessionResult,
+    serial: bytes,
+) -> dict[str, object]:
+    """Validate one injected fault and return a bounded recovery receipt."""
+
+    observed = _FAULT_RE.findall(serial)
+    expected_marker = fault.value.encode("ascii")
+    if observed != [expected_marker]:
+        raise RecoveryFaultError(
+            f"expected exactly one {fault.value!r} fault marker; observed {observed!r}"
+        )
+    expected_failure = _expected_failure(fault)
+    if result.failure != expected_failure:
+        raise RecoveryFaultError(
+            f"{fault.value} expected {expected_failure}, got {result.failure}"
+        )
+    if not result.timed_out:
+        raise RecoveryFaultError(f"{fault.value} was not bounded by a timeout")
+    if not result.cleanup_complete:
+        raise RecoveryFaultError(f"{fault.value} left the process group alive")
+    if result.recovery_complete:
+        raise RecoveryFaultError(f"{fault.value} unexpectedly reported recovery")
+    if result.booti_sent_count > 1:
+        raise RecoveryFaultError(f"{fault.value} sent booti more than once")
+
+    if fault is RecoveryFault.UBOOT_WAIT:
+        classification = "uboot-wait"
+    elif fault is RecoveryFault.SBI_RESET_FAILURE:
+        classification = "sbi-reset-failure"
+    elif fault is RecoveryFault.TIMER_DISABLED:
+        classification = "kernel-hang:timer-disabled"
+    else:
+        classification = "kernel-hang:mmio-permanent-block"
+    boot_ids: list[str] = []
+    for match in _BOOT_ID_RE.findall(serial):
+        boot_id = match.decode("ascii").lower()
+        if boot_id not in boot_ids:
+            boot_ids.append(boot_id)
+    return {
+        "schema": "asterinas.qemu-recovery-fault-receipt.v1",
+        "fault": fault.value,
+        "classification": classification,
+        "failure": result.failure,
+        "contained": result.cleanup_complete,
+        # The current fault peer is deliberately a bounded host-side serial
+        # process.  It does not execute the Asterinas kernel or arm a real
+        # hardware watchdog; keeping this provenance in every receipt avoids
+        # promoting a protocol test into a hardware claim.
+        "execution_scope": "host-serial-peer",
+        "watchdog_state": "not-modeled",
+        "recovery_state": "not-recovered",
+        "boot_ids": boot_ids,
+        "booti_sent_count": result.booti_sent_count,
+        "serial_bytes": len(serial),
+        "serial_tail_sha256": hashlib.sha256(serial[-4096:]).hexdigest(),
+        "serial_tail": serial[-4096:].decode("utf-8", errors="replace"),
+    }
+
+
+def _write_fake_qemu(path: Path, fault: RecoveryFault) -> None:
+    """Write a tiny unbuffered serial peer for one fault scenario."""
+
+    marker = fault.value
+    if fault is RecoveryFault.UBOOT_WAIT:
+        body = (
+            "print('OpenSBI v1.7 boot_id=01234567-89ab-cdef-0123-456789abcdef', flush=True)\n"
+            "print('U-Boot 2026.07', flush=True)\n"
+            f"print('ASTERINAS_FAULT_INJECTED fault={marker}', flush=True)\n"
+            "time.sleep(60)\n"
+        )
+    elif fault is RecoveryFault.SBI_RESET_FAILURE:
+        body = (
+            "print('OpenSBI v1.7 boot_id=01234567-89ab-cdef-0123-456789abcdef', flush=True)\n"
+            "print('=> ', end='', flush=True)\n"
+            "for line in sys.stdin:\n"
+            " if line.startswith('booti '):\n"
+            f"  print('ASTERINAS_FAULT_INJECTED fault={marker}', flush=True)\n"
+            "  print('ASTERINAS_REBOOT_TIMER_READY', flush=True)\n"
+            "  time.sleep(60)\n"
+        )
+    else:
+        body = (
+            "print('OpenSBI v1.7 boot_id=01234567-89ab-cdef-0123-456789abcdef', flush=True)\n"
+            "print('=> ', end='', flush=True)\n"
+            "for line in sys.stdin:\n"
+            " if line.startswith('booti '):\n"
+            f"  print('ASTERINAS_FAULT_INJECTED fault={marker}', flush=True)\n"
+            "  time.sleep(60)\n"
+        )
+    path.write_text(
+        "import sys\nimport time\n"
+        "sys.stdout.reconfigure(line_buffering=True)\n"
+        + body,
+        encoding="utf-8",
+    )
+
+
+def run_fault(fault: RecoveryFault, directory: Path) -> FaultRun:
+    """Run one synthetic fault with bounded timeouts and no retry."""
+
+    fake = directory / f"{fault.value}.py"
+    _write_fake_qemu(fake, fault)
+    log_path = directory / f"{fault.value}.serial"
+    kwargs: dict[str, object] = {
+        "startup_timeout": 0.2,
+        "command_timeout": 0.2,
+        "boot_timeout": 0.25,
+        "termination_grace": 0.2,
+    }
+    if fault is RecoveryFault.SBI_RESET_FAILURE:
+        kwargs["reboot_expectation"] = RebootExpectation(
+            trigger_marker=REBOOT_TIMER_READY,
+            recovery_timeout=0.2,
+            milestones=(("opensbi", b"OpenSBI v1.7"),),
+        )
+    else:
+        kwargs["reboot_expectation"] = None
+    result = run_serial_session(
+        [sys.executable, "-u", str(fake)],
+        commands=(BootCommand("booti", "booti image", "UNREACHABLE"),),
+        raw_log_path=log_path,
+        **kwargs,
+    )
+    serial = log_path.read_bytes()
+    return FaultRun(fault, result, serial, classify_fault(fault, result, serial))
+
+
+def run_fault_matrix() -> tuple[FaultRun, ...]:
+    """Run every fault in an isolated temporary output directory."""
+
+    with tempfile.TemporaryDirectory(prefix="asterinas-recovery-fault-") as root:
+        directory = Path(root)
+        return tuple(run_fault(fault, directory) for fault in RecoveryFault)
+
+
+def build_fault_matrix_receipt(runs: Sequence[FaultRun]) -> dict[str, object]:
+    """Build a non-qualifying receipt for the bounded host fault matrix.
+
+    ``passed`` deliberately remains false: the matrix proves classification and
+    cleanup, but this adapter does not arm a guest or hardware watchdog and
+    therefore cannot prove recovery.  ``classification_complete`` is the
+    positive result consumed by host tests and evidence tooling.
+    """
+
+    items = [dict(run.receipt) for run in runs]
+    scopes = {item.get("execution_scope") for item in items}
+    watchdog_states = {item.get("watchdog_state") for item in items}
+    if scopes != {"host-serial-peer"}:
+        raise RecoveryFaultError(f"unexpected fault scopes: {sorted(scopes)!r}")
+    if watchdog_states != {"not-modeled"}:
+        raise RecoveryFaultError(
+            f"unexpected watchdog states: {sorted(watchdog_states)!r}"
+        )
+    return {
+        "schema": "asterinas.qemu-recovery-fault-matrix-receipt.v1",
+        "execution_scope": "host-serial-peer",
+        "hardware_state": "not-accessed",
+        "watchdog_state": "not-modeled",
+        "recovery_state": "not-recovered",
+        "passed": False,
+        "classification_complete": True,
+        "fault_count": len(items),
+        "faults": items,
+    }
+
+
+def _parse_args(argv: Sequence[str] | None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description="run the bounded host-side recovery fault matrix"
+    )
+    parser.add_argument("--output", type=Path, required=True)
+    return parser.parse_args(argv)
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    args = _parse_args(argv)
+    try:
+        receipt = build_fault_matrix_receipt(run_fault_matrix())
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(
+            json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+        )
+    except (OSError, RecoveryFaultError) as error:
+        print(f"qemu recovery fault matrix: {error}", file=sys.stderr)
+        return 2
+    print(json.dumps(receipt, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
