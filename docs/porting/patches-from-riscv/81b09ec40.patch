+        let mut io = FakePowerIo::new(EXPECTED_GPU_ID);
+        let lease = AtomicU8::new(LEASE_IDLE);
+        let original = claim_power(&mut io, &lease).unwrap();
+        io.catalogue_base = 0x1f16a3;
+        io.actions.clear();
+
+        assert_eq!(
+            close_power_session(&mut io, &lease, original, true, true),
+            Ok(EXPECTED_INITIAL)
