+/// Reads one little-endian bit field out of a report without interpreting it.
+fn raw_field(bytes: &[u8], offset: u8, bits: u8) -> Option<u32> {
+    if bits == 0 || bits >= 32 {
+        return None;
+    }
+    if usize::from(offset) + usize::from(bits) > bytes.len() * 8 {
+        return None;
+    }
