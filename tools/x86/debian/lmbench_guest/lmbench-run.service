[Unit]
Description=Asterinas native LMBench ALL run
# `WantedBy=multi-user.target` already pulls this unit into the target's job.
# Adding `After=multi-user.target` here creates an ordering cycle (the target
# waits for the unit, the unit waits for the target), which systemd resolves
# by deleting one of the jobs.
After=network.target

[Service]
Type=oneshot
KeyringMode=inherit
ExecStart=/opt/lmbench-run.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=7200
# The runner's own deadline defaults to 900s, which is what the guest's slower
# TCG execution runs into: the ALL suite reached 73 of 109 measurements and was
# killed mid-run. The unit above allows two hours, so give the suite room.
Environment=LMBENCH_TIMEOUT=3600

[Install]
WantedBy=multi-user.target
