[Unit]
Description=Asterinas bounded systemd-logind diagnostic
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-sysusers.service ldconfig.service systemd-journal-catalog-update.service sysinit.target

[Service]
Type=oneshot
Environment=ASTERINAS_LOGIND_DIAGNOSTIC_TIMEOUT_SECONDS=300
Environment=ASTERINAS_LOGIND_DIAGNOSTIC_SAMPLE_INTERVAL_SECONDS=5
ExecStart=/bin/sh -c '/usr/lib/asterinas/logind-diagnostic >/dev/null 2>&1 &'
TimeoutStartSec=330s
KillMode=mixed
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
