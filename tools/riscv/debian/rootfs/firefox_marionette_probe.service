[Unit]
Description=Asterinas Firefox Marionette short probe
Requires=asterinas-desktop-m4.service
After=asterinas-desktop-m4.service

[Service]
Type=oneshot
User=asterinas
SupplementaryGroups=render
Environment=HOME=/home/asterinas
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/asterinas/.Xauthority
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ASTERINAS_FIREFOX_PROBE_ONLY=1
# The host gate supplies the bounded budget through systemd.setenv.  Do not
# hard-code a second value here; that would silently defeat short probes.
ExecStart=/usr/lib/asterinas/firefox-drm-scene-gate
TimeoutStartSec=420s
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=basic.target
