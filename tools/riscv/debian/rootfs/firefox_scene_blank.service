[Unit]
Description=Asterinas DRM Firefox WebRender scene gate
Requires=asterinas-desktop-m4.service
After=asterinas-desktop-m4.service

[Service]
Type=oneshot
User=asterinas
SupplementaryGroups=render
Environment=HOME=/home/asterinas
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/asterinas/.Xauthority
Environment=PYTHONDONTWRITEBYTECODE=1
# Start on a blank page so the initial window can finish loading before the
# scene's animation loop begins; the gate navigates to the scene afterwards.
Environment=ASTERINAS_FIREFOX_START_URL=about:blank
ExecStart=/usr/lib/asterinas/firefox-drm-scene-gate
# Scene run plus one bounded recovery launch on TCG.
TimeoutStartSec=1500s
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=basic.target
