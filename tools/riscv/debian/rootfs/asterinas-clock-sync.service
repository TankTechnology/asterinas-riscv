[Unit]
Description=Asterinas clock sync from an HTTP Date header
# The board powers up at a fixed date every time, and the guest cannot reach an
# NTP server before the campus portal login. The gateway answers HTTP even
# unauthenticated, so its Date header is used instead. This must finish before
# anything validates a certificate: Firefox shows "Your Computer Clock is
# Wrong" and curl rejects every HTTPS site until the clock is right.
DefaultDependencies=no
After=sysinit.target
Before=asterinas-browser-web.service asterinas-desktop-m4.service asterinas-desktop-m5-network.service
# No `Wants=network.target` here, deliberately. This unit is pulled in by
# basic.target (DefaultDependencies=no), and network.target is ordered after
# systemd-networkd.service, which is itself ordered after basic.target. Wanting
# it from inside basic.target therefore closes an ordering cycle, and systemd
# resolves the cycle by dropping the job -- the unit then never runs at boot
# and the clock stays at the power-on value. The sync does not need the target:
# its first source is the gateway by address, not by name.

[Service]
Type=oneshot
RemainAfterExit=yes
# Run it through the shell explicitly: the file is pushed over the serial
# console during bring-up and its shebang line is the first thing a dropped
# character can eat.
ExecStart=/bin/sh /usr/lib/asterinas/clock-sync
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=basic.target
