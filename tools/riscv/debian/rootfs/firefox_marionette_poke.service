[Unit]
Description=Asterinas Firefox Marionette wake probe
Requires=asterinas-desktop-m4.service
After=asterinas-desktop-m4.service

[Service]
Type=oneshot
User=asterinas
SupplementaryGroups=render
Environment=HOME=/home/asterinas
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/asterinas/.Xauthority
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ASTERINAS_FIREFOX_PROBE_ONLY=1
Environment=ASTERINAS_FIREFOX_REMOTE_TRACE=1
Environment=ASTERINAS_FIREFOX_PROBE_TIMEOUT=300
Environment=ASTERINAS_FIREFOX_NEWSESSION_CAPS=minimal
# Start on a blank page so the initial window can finish loading before the
# scene's animation loop begins; the scene is navigated after the session.
Environment=ASTERINAS_FIREFOX_START_URL=about:blank
ExecStart=/usr/lib/asterinas/firefox-drm-scene-gate
TimeoutStartSec=600s
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

[Install]
WantedBy=basic.target
