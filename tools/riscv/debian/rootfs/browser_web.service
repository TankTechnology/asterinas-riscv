[Unit]
Description=Asterinas Debian online Firefox workload
# Starting the Xorg session can remain in the activating state on a minimal
# Asterinas device even after it has spawned Xorg.  Launch the browser in
# parallel and let wait-x provide the real readiness barrier; tying browser
# activation to the desktop unit otherwise causes an unbounded dependency
# wait and Firefox never starts.
# Network evidence is a parallel prerequisite for the formal evidence service,
# not for launching Firefox about:blank.  Keeping it as Wants lets Xorg and the
# browser start while the bounded fixture batch runs; browser_web_evidence.service
# still Requires/After-orders the strict DNS/TLS/content checks on completion.
Wants=asterinas-desktop-m5-network.service
Requires=asterinas-browser-web-timeline-basic.service
After=asterinas-browser-web-timeline-basic.service

[Service]
Type=exec
User=asterinas
PrivateTmp=no
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
Environment=HOME=/home/asterinas
Environment=ASTERINAS_FIREFOX_WEB_TARGET_URL=https://www.baidu.com/
SupplementaryGroups=video input
StandardOutput=journal+console
StandardError=journal+console
ExecStartPre=+/usr/lib/asterinas/desktop-m5-device-access
ExecStart=/usr/lib/asterinas/browser-web-firefox
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical.target
