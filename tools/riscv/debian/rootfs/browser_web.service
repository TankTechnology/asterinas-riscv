[Unit]
Description=Asterinas Debian online Firefox workload
# The board starts with a dummy 1970 RTC.  The network service obtains a trusted
# HTTP Date and corrects CLOCK_REALTIME.  Do not start Firefox or its timeout
# helpers across that clock step: it can invalidate their first startup epoch
# and make the initial TLS request fail even though a retry later succeeds.
Requires=asterinas-desktop-m5-network.service
After=asterinas-desktop-m5-network.service
Requires=asterinas-browser-web-timeline-basic.service
After=asterinas-browser-web-timeline-basic.service

[Service]
Type=exec
User=asterinas
PrivateTmp=no
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
Environment=HOME=/home/asterinas
Environment=ASTERINAS_FIREFOX_WEB_TARGET_URL=https://www.baidu.com/
SupplementaryGroups=video input
StandardOutput=journal+console
StandardError=journal+console
ExecStartPre=+/usr/lib/asterinas/desktop-m5-device-access
ExecStart=/usr/lib/asterinas/browser-web-firefox
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical.target
