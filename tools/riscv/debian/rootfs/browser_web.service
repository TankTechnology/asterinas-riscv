[Unit]
Description=Asterinas Debian online Firefox workload
Requires=asterinas-desktop-m5.service asterinas-desktop-m5-network.service
After=asterinas-desktop-m5.service asterinas-desktop-m5-network.service

[Service]
Type=simple
User=asterinas
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
Environment=HOME=/home/asterinas
ExecStart=/usr/lib/asterinas/browser-web-firefox
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical.target
