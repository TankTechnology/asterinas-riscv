[Unit]
Description=Asterinas Debian online Firefox workload
# Starting the Xorg session can remain in the activating state on a minimal
# Asterinas device even after it has spawned Xorg.  Launch the browser in
# parallel and let wait-x provide the real readiness barrier; tying browser
# activation to the desktop unit otherwise causes an unbounded dependency
# wait and Firefox never starts.
Requires=asterinas-desktop-m5-network.service
After=asterinas-desktop-m5-network.service
Requires=asterinas-browser-web-timeline-basic.service
After=asterinas-browser-web-timeline-basic.service

[Service]
Type=simple
User=asterinas
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
Environment=HOME=/home/asterinas
SupplementaryGroups=video input
ExecStart=/usr/lib/asterinas/browser-web-firefox
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical.target
