[Unit]
Description=Asterinas wired-port watchdog
After=basic.target

[Service]
Type=simple
ExecStart=/bin/sh /usr/lib/asterinas/net-watchdog
Restart=always
RestartSec=10
EnvironmentFile=-/etc/asterinas/net-watchdog.conf
StandardOutput=journal+console
StandardError=journal+console

[Install]
# multi-user.target is never activated on this image (it is enabled and
# inactive forever, which is how this watchdog silently did not run), so it
# hangs off the target the boot actually reaches.
WantedBy=multi-user.target asterinas-debug-console.target
