#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""dsh: a local DeepSeek-driven board agent for the Megrez board.

Naming note: this tool is NOT the official DeepSeek Harness
(https://github.com/deepseek-ai/deepseek-harness, `@deepseek-ai/dsh`). That one
is a TypeScript/Cordis plugin runtime that runs on the board as `dsh web` and
is documented in docs/porting/2026-11-10-node24-jit-and-dsh.md. The shared name
is a local collision that has caused confusion: this directory is a minimal
board agent with four tools and no sandbox or permission layer.

    dsh "run uname -a on the board and report the kernel"
    dsh --dry-run
    dsh --allow-reboot "reboot the board and wait for the console"

The API key is read from DSH_API_KEY, DEEPSEEK_API_KEY or ANTHROPIC_API_KEY
and is never written anywhere.
"""

from __future__ import annotations

import sys
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO_ROOT = TOOLS.parent.parent
sys.path.insert(0, str(REPO_ROOT))

from tools.riscv.deepseek import runner  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(runner.main())
