#!/usr/bin/env python3
# SPDX-License-Identifier: MPL-2.0
"""Single entry point for the RISC-V/Megrez tooling.

Follows the Linux tools layout: one executable with subcommands, while the
implementation lives in the domain packages under this directory. Every
subcommand behaves exactly like the module or script it replaced; `rt` only
sets up the import path and forwards the remaining arguments.

    rt test                      # host test suite
    rt gate rootfs               # Debian image gates (see `rt --list`)
    rt qemu-boot --help          # U-Boot booti runner
    rt ltp-run --help
    rt board --help

Run `rt --list` to see every command.
"""

from __future__ import annotations

import os
import runpy
import sys
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO_ROOT = TOOLS.parent.parent

# Directories whose modules are imported by bare sibling name (the pattern the
# gates used before this entry point existed).
_IMPORT_DIRS = (
    TOOLS,
    TOOLS / "qemu",
    TOOLS / "megrez" / "board",
    TOOLS / "megrez" / "desktop",
    TOOLS / "megrez" / "image",
    TOOLS / "megrez" / "network",
)

# Integration gates: one entry per scenario. The implementation modules keep
# their own arguments; `rt gate <name>` is the only public spelling.
GATES: dict[str, str] = {
    "rootfs": "tools.riscv.debian.rootfs.rootfs_gate",
    "desktop": "tools.riscv.debian.rootfs.desktop_m5_qemu_gate",
    "desktop-drm": "tools.riscv.debian.rootfs.desktop_drm_gate",
    "debug-console": "tools.riscv.debian.rootfs.debug_console_qemu_gate",
    "browser-web": "tools.riscv.debian.rootfs.browser_web_qemu_gate",
    "daily-use": "tools.riscv.debian.rootfs.daily_use_gate",
    "graphics-physical": "tools.riscv.physical_graphics_qemu_gate",
}

# command -> ("module", dotted module that runs as __main__)
#            ("script", path relative to this directory)
COMMANDS: dict[str, tuple[str, str]] = {
    # host tests and kernel tests
    "test": ("module", "tools.riscv.host_test_runner"),
    "selftest": ("module", "tools.riscv.selftests.runner"),
