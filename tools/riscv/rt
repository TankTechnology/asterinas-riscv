def _usage() -> str:
    lines = ["usage: rt <command> [args...]", "", "commands:"]
    for name in sorted(COMMANDS):
        lines.append(f"  {name}")
    lines += ["", "gates (rt gate <name> [args...]):"]
    for name in sorted(GATES):
        lines.append(f"  {name}")
    return "\n".join(lines)


def _prepare_environment() -> None:
    for directory in (REPO_ROOT, *_IMPORT_DIRS):
        if str(directory) not in sys.path:
            sys.path.insert(0, str(directory))
    entries = [str(REPO_ROOT), *(str(d) for d in _IMPORT_DIRS)]
    existing = os.environ.get("PYTHONPATH")
    if existing:
        entries.append(existing)
    os.environ["PYTHONPATH"] = os.pathsep.join(entries)


def _run_module(module: str, argv: list[str]) -> None:
    _prepare_environment()
    sys.argv = [module, *argv]
    runpy.run_module(module, run_name="__main__", alter_sys=True)


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help"):
        print(_usage())
        return 0 if args else 2
    if args[0] in ("-l", "--list"):
        names = [*sorted(COMMANDS), *(f"gate {name}" for name in sorted(GATES))]
        print("\n".join(names))
        return 0

    command = args[0]
    if command == "gate":
        if len(args) < 2 or args[1] in ("-h", "--help"):
            print("gates:")
            for name in sorted(GATES):
                print(f"  {name}")
            return 0 if len(args) >= 2 else 2
        gate = args[1]
        module = GATES.get(gate)
        if module is None:
            print(f"rt: unknown gate: {gate}\n\n{_usage()}", file=sys.stderr)
            return 2
        _run_module(module, args[2:])
        return 0

    entry = COMMANDS.get(command)
    if entry is None:
        print(f"rt: unknown command: {command}\n\n{_usage()}", file=sys.stderr)
        return 2

    _prepare_environment()
    kind, target = entry
    if kind == "module":
        _run_module(target, args[1:])
        return 0

    script = TOOLS / target
    if not script.is_file():
        print(f"rt: missing script: {script}", file=sys.stderr)
        return 2
    sys.argv = [str(script), *args[1:]]
    os.execv(str(script), sys.argv)
    return 0


if __name__ == "__main__":
    sys.exit(main())
