[Unit]
Description=GTK3 smoke window (bare X11, no WM)
After=xorg.service
Requires=xorg.service
PartOf=graphical.target
StartLimitIntervalSec=0

[Service]
KeyringMode=inherit
Type=simple
Environment=DISPLAY=:0
Environment=HOME=/root
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/gtk3-hello
Restart=on-failure
RestartSec=2s
