[Unit]
Description=Nix profile smoke test (run installed binaries by bare name)
After=nix-activation.service
Requires=nix-activation.service
Before=graphical.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
Environment=PATH=/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/busybox sh /etc/nix-smoke.sh
StandardOutput=tty
StandardError=tty
