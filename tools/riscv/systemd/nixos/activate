#!/bin/sh
# SPDX-License-Identifier: MPL-2.0
#
# NIXOS-STAGE2-M1 activation — a *minimal* switch-to-configuration.
#
# The real NixOS `switch-to-configuration` (perl script) does, among other
# things: (1) build /run/current-system as a symlink to the new system
# closure, (2) build /run/current-system/sw as a symlink farm over the
# `environment.systemPackages`, (3) activate /etc from /etc/static, and
# (4) update the system profile + reload changed units. This script does the
# subset that matters for "nix-profile-installed software referenced from a
# systemd environment":
#
#   1. /run/current-system        -> the active nix profile (the "current system")
#   2. /run/current-system/sw/bin -> symlink farm of every profile bin
#   3. /usr/local/bin/<name>      -> profile bin (the "link into /usr/local/bin"
#                                   alternative to exporting PATH)
#   4. /etc/profile               -> login-shell environment
#   5. /etc/environment + /etc/environment.d/10-nix.conf -> systemd default env
#
# Idempotent: safe to re-run (it only (re)creates symlinks and files).

set -u

PROFILE=/nix/var/nix/profiles/default
SW=/run/current-system/sw
PATH_PREFIX="$PROFILE/bin:$SW/bin:/usr/local/bin:/usr/bin:/bin"

# 1. The NixOS "current system" symlink resolves through the active profile.
mkdir -p /run/current-system
ln -sfn "$PROFILE" /run/current-system/system

# 2. /run/current-system/sw — the canonical NixOS symlink farm of package bins.
rm -rf "$SW"
mkdir -p "$SW/bin"
for exe in "$PROFILE"/bin/*; do
    [ -e "$exe" ] || continue
    name="${exe##*/}"
    ln -sfn "$exe" "$SW/bin/$name"
done

# 3. Also link each profile bin into /usr/local/bin (the "链进 /usr/local/bin"
#    option from the task spec), so absolute-path consumers outside the profile
#    find them too.
mkdir -p /usr/local/bin
for exe in "$PROFILE"/bin/*; do
    [ -e "$exe" ] || continue
    name="${exe##*/}"
    ln -sfn "$exe" "/usr/local/bin/$name"
done

# 4. Login-shell environment (sourced by login/getty shells as /etc/profile).
cat > /etc/profile <<EOF
# /etc/profile — generated by /etc/activate (NIXOS-STAGE2-M1).
export PATH="$PATH_PREFIX"
export NIX_PROFILES="$PROFILE /root/.nix-profile"
EOF

# 5. systemd default environment:
#    - /etc/environment is imported by systemd PID 1 at startup, and
#    - /etc/environment.d/*.conf is systemd's environment.d drop-in, applied
#      as the default environment of every service.
cat > /etc/environment <<EOF
PATH=$PATH_PREFIX
NIX_PROFILES=$PROFILE /root/.nix-profile
EOF
mkdir -p /etc/environment.d
cat > /etc/environment.d/10-nix.conf <<EOF
# Generated by /etc/activate (NIXOS-STAGE2-M1).
PATH=$PATH_PREFIX
NIX_PROFILES=$PROFILE /root/.nix-profile
EOF

echo "__NIX_ACTIVATION_OK__ profile=$PROFILE"
echo "  sw=$SW"
echo "  /usr/local/bin: linked from profile bin"
echo "  generated: /etc/profile /etc/environment /etc/environment.d/10-nix.conf"
